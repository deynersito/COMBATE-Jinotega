[Statedef -2]
[State -2, AI OwnMovement]
type = AssertSpecial
trigger1 = AILevel > 0
flag = NoHardcodedKeys
ignorehitpause = 1

[State -2, AI SustainGuard]
type = AssertInput
triggerall = AILevel > 0
trigger1 = StateNo >= 120 && StateNo <= 155 && P2MoveType = A && InGuardDist
flag = B
