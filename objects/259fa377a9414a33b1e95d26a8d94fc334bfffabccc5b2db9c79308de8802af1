[State -1, AI ExitOwnCorner]
type = ChangeState
triggerall = AILevel > 0 && RoundState = 2 && Ctrl && StateType = S
triggerall = Var(56) <= 0
triggerall = BackEdgeBodyDist < 85
trigger1 = P2BodyDist X > 120
value = 2853

[State -1, AI CenterExchange]
type = ChangeState
triggerall = AILevel > 0 && RoundState = 2 && Ctrl && StateType = S
triggerall = Var(56) <= 0
